# Copy to .env and fill in what you use. .env is never committed or shown in chat.

# Voiceover through ElevenLabs (voice.provider: elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Parallel render workers. Each one is a Chrome instance, so keep this low on 8-16 GB of RAM.
RENDER_WORKERS=2
